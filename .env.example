APP_NAME=pet-comprehensive-platform
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
API_PREFIX=/api/v1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pet_platform
MYSQL_USER=pet_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=root_change_me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

JWT_SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads
MAX_UPLOAD_SIZE_MB=5
ORDER_PAY_TIMEOUT_MINUTES=30

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

USER_WEB_ORIGIN=http://localhost:5173
ADMIN_WEB_ORIGIN=http://localhost:5174
