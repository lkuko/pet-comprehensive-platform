# 双前端静态站点镜像（多阶段构建）
# 构建上下文为项目根目录：docker build -f deploy/Dockerfile.web -t pet-web .

# 阶段 1：构建管理端
FROM node:20-alpine AS admin-builder
WORKDIR /app
COPY admin-web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY admin-web/ .
RUN npm run build

# 阶段 2：构建用户端
FROM node:20-alpine AS user-builder
WORKDIR /app
COPY user-web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY user-web/ .
RUN npm run build

# 阶段 3：Nginx 托管两个前端并反代后端
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=admin-builder /app/dist /usr/share/nginx/html/admin
COPY --from=user-builder /app/dist /usr/share/nginx/html/user

EXPOSE 80 81
